{
  "name": "clothes-size-converter",
  "version": "1.0.1",
  "description": "A simple package for converting global clothes sizes EU, UK, US, Asia etc",
  "keywords": [
    "Clothes",
    "size",
    "converter"
  ],
  "homepage": "https://github.com/MoMalley254/clothes-size-converter#readme",
  "bugs": {
    "url": "https://github.com/MoMalley254/clothes-size-converter/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoMalley254/clothes-size-converter.git"
  },
  "license": "ISC",
  "author": "Morris K. Njuguna",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "src/converters/",
    "src/data/",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:types": "tsc -p tsconfig.json",
    "prepublishOnly": "npm test && npm run test:types"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/__tests__/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "index.js",
      "src/converters/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 95,
        "branches": 90,
        "functions": 95,
        "lines": 95
      }
    }
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "typescript": "^7.0.2"
  }
}
